{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountAccessEnded",
  "description": "An agent's access to an account ended.",
  "x-kind": "event",
  "type": "object",
  "required": [
    "grant_ref",
    "customer_account_ref",
    "agent_ref",
    "reason"
  ],
  "properties": {
    "grant_ref": {
      "$ref": "../../defs.json#/$defs/uuid"
    },
    "customer_account_ref": {
      "$ref": "../../defs.json#/$defs/uuid"
    },
    "agent_ref": {
      "description": "Core agent id of the member of staff.",
      "$ref": "../../defs.json#/$defs/uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "call_ended",
        "expired",
        "idle",
        "revoked"
      ]
    }
  }
}
