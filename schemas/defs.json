{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teledash.local/schemas/defs.json",
  "title": "Shared definitions",
  "description": "Referenced from message schemas as defs.json#/$defs/<name>. Inlined by codegen.",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "money": {
      "description": "GBP amount as a decimal string with two places, e.g. \"12.50\". Never a float.",
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "msisdn": {
      "description": "E.164 without the plus, e.g. 447700900123.",
      "type": "string",
      "pattern": "^44[0-9]{10}$"
    },
    "iccid": { "type": "string", "pattern": "^8944[0-9]{15,16}$" },
    "date": { "type": "string", "format": "date" },
    "datetime": { "type": "string", "format": "date-time" },
    "address": {
      "type": "object",
      "required": ["line_1", "town", "postcode", "country_code"],
      "properties": {
        "line_1": { "type": "string" },
        "line_2": { "type": ["string", "null"] },
        "town": { "type": "string" },
        "postcode": { "type": "string" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "failure": {
      "description": "Why a command failed. retryable=false means the orchestrator should compensate rather than retry.",
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
