{
    "name": "teledash/contracts",
    "description": "Teledash message envelope and command/event schemas, with generated PHP DTOs.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "opis/json-schema": "^2.4",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": { "Teledash\\Contracts\\": "php/src/" }
    },
    "autoload-dev": {
        "psr-4": { "Teledash\\Contracts\\Tests\\": "php/tests/" }
    },
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true }
    }
}
