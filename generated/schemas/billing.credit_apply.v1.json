{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BillingCreditApply",
  "description": "Apply an approved goodwill credit.",
  "x-kind": "command",
  "type": "object",
  "required": [
    "approval_ref",
    "customer_account_ref",
    "amount",
    "reason_code",
    "description"
  ],
  "properties": {
    "approval_ref": {
      "type": "string",
      "format": "uuid"
    },
    "customer_account_ref": {
      "type": "string",
      "format": "uuid"
    },
    "billing_account_ref": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null: the customer's default billing account."
    },
    "amount": {
      "description": "GBP amount as a decimal string with two places, e.g. \"12.50\". Never a float.",
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "reason_code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "$id": "https://teledash.local/schemas/messages/billing.credit_apply/v1.json"
}
