{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BillingCreditApplied",
  "description": "A credit was applied to a billing account.",
  "x-kind": "event",
  "type": "object",
  "required": [
    "approval_ref",
    "billing_account_ref",
    "amount"
  ],
  "properties": {
    "approval_ref": {
      "type": "string",
      "format": "uuid"
    },
    "billing_account_ref": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "description": "GBP amount as a decimal string with two places, e.g. \"12.50\". Never a float.",
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "charge_ref": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "https://teledash.local/schemas/messages/billing.credit_applied/v1.json"
}
