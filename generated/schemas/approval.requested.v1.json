{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalRequested",
  "description": "A credit, refund, exchange or termination was requested.",
  "x-kind": "event",
  "type": "object",
  "required": [
    "approval_ref",
    "type",
    "customer_account_ref",
    "requested_by_ref",
    "status",
    "queue"
  ],
  "properties": {
    "approval_ref": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "credit",
        "refund",
        "exchange",
        "termination"
      ]
    },
    "customer_account_ref": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "oneOf": [
        {
          "description": "GBP amount as a decimal string with two places, e.g. \"12.50\". Never a float.",
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_by_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Core agent id of the member of staff."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved"
      ]
    },
    "queue": {
      "type": "string",
      "enum": [
        "auto",
        "manager",
        "admin"
      ]
    }
  },
  "$id": "https://teledash.local/schemas/messages/approval.requested/v1.json"
}
