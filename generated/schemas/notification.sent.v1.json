{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotificationSent",
  "description": "A notification was delivered.",
  "x-kind": "event",
  "type": "object",
  "required": [
    "notification_id",
    "channel",
    "to",
    "delivered_at"
  ],
  "properties": {
    "notification_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "email"
      ]
    },
    "to": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$id": "https://teledash.local/schemas/messages/notification.sent/v1.json"
}
